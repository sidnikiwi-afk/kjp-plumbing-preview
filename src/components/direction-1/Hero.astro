---
/**
 * Hero — Full-bleed plumber image, thick red banner headline, asymmetric layout.
 * Diagonal clip on the image. Staggered entrance animation.
 */
---

<section class="relative min-h-screen bg-brand-secondary overflow-hidden pt-20" id="hero">
  <!-- Noise texture overlay -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml;base64,');"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-8 items-center min-h-[calc(100vh-5rem)]">
      <!-- Text side -->
      <div class="py-12 lg:py-20 order-2 lg:order-1">
        <!-- Micro label -->
        <div class="hero-fade hero-delay-1 flex items-center gap-3 mb-6">
          <div class="w-8 h-0.5 bg-brand-primary"></div>
          <span class="text-brand-primary font-body font-bold text-xs tracking-[0.25em] uppercase">Southampton's Trusted Plumber</span>
        </div>

        <!-- Main headline -->
        <h1 class="hero-fade hero-delay-2 font-heading font-black uppercase leading-[0.9] tracking-tight">
          <span class="block text-white" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">Local Plumber In</span>
          <!-- Red banner headline (motif #2 - angled banner) -->
          <span class="inline-block bg-brand-primary text-white px-4 py-2 mt-2 -ml-4 relative" style="font-size: clamp(2.5rem, 6vw, 4.5rem); clip-path: polygon(2% 0, 100% 0, 98% 100%, 0 100%);">
            Southampton
          </span>
          <span class="block text-white/60 mt-2" style="font-size: clamp(1.2rem, 2.5vw, 1.8rem);">& Emergency Plumbing Services</span>
        </h1>

        <!-- Subtext -->
        <p class="hero-fade hero-delay-3 text-brand-accent/60 font-body text-base sm:text-lg mt-6 max-w-lg leading-relaxed">
          Professional Plumbing & Heating Services & Emergency Plumber in Southampton & The Local Surrounding Areas.
        </p>

        <!-- Dual CTAs -->
        <div class="hero-fade hero-delay-4 flex flex-col sm:flex-row gap-4 mt-8">
          <a href="#contact" class="group inline-flex items-center justify-center gap-2 bg-brand-primary hover:bg-red-700 text-white px-8 py-4 font-heading font-black text-base tracking-wider uppercase transition-all duration-300 hover:translate-y-[-2px] hover:shadow-[0_8px_30px_rgba(198,40,40,0.4)]" style="clip-path: polygon(0 0, 100% 0, 97% 100%, 3% 100%);">
            Request a Quote
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </a>
          <a href="tel:02381112994" class="inline-flex items-center justify-center gap-2 border-2 border-white/20 hover:border-brand-primary text-white px-8 py-4 font-heading font-black text-base tracking-wider uppercase transition-all duration-300 hover:bg-brand-primary/10">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call Now
          </a>
        </div>

        <!-- Trust row -->
        <div class="hero-fade hero-delay-5 flex items-center gap-6 mt-10 pt-6 border-t border-white/10">
          <div class="flex items-center gap-2">
            <div class="flex -space-x-1">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <span class="text-white/70 font-body text-sm">5-Star Google Reviews</span>
          </div>
          <div class="hidden sm:block w-px h-6 bg-white/20"></div>
          <span class="hidden sm:block text-white/70 font-body text-sm">25+ Years Experience</span>
        </div>
      </div>

      <!-- Image side -->
      <div class="hero-fade hero-delay-3 relative order-1 lg:order-2">
        <div class="relative">
          <!-- Angular clip on the image (motif #3) -->
          <div class="hero-image-wrap relative overflow-hidden rounded-lg">
            <img
              src="/images/redesign/image-10.jpg"
              alt="Modern bathroom installation by KJP Plumbing Southampton"
              class="w-full h-[500px] object-cover object-center relative z-10"
            />
            <!-- Red accent shape behind image -->
            <div class="absolute -bottom-4 -right-4 w-3/4 h-3/4 bg-brand-primary/20 -z-0" style="clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Angled section divider (motif #4) -->
  <div class="absolute bottom-0 left-0 right-0">
    <div class="hazard-divider h-3"></div>
    <svg class="w-full h-12 sm:h-16 text-brand-bg" viewBox="0 0 1440 64" preserveAspectRatio="none">
      <path fill="currentColor" d="M0,0 L1440,48 L1440,64 L0,64 Z"/>
    </svg>
  </div>
</section>

<style>
  .hazard-divider {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-brand-primary),
      var(--color-brand-primary) 10px,
      var(--color-brand-secondary) 10px,
      var(--color-brand-secondary) 20px
    );
  }

  /* Staggered entrance */
  .hero-fade {
    opacity: 0;
    transform: translateY(30px);
    animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-delay-1 { animation-delay: 0.1s; }
  .hero-delay-2 { animation-delay: 0.25s; }
  .hero-delay-3 { animation-delay: 0.4s; }
  .hero-delay-4 { animation-delay: 0.55s; }
  .hero-delay-5 { animation-delay: 0.7s; }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
