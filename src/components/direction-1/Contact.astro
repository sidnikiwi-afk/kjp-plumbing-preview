---
/**
 * Contact form — dark section with form on left, info on right.
 * Sharp edges, industrial feel.
 */
---

<section id="contact" class="relative bg-brand-secondary py-20 sm:py-28 overflow-hidden">
  <!-- Hazard stripe top -->
  <div class="absolute top-0 left-0 right-0 h-2 hazard-stripe-red"></div>

  <!-- Noise -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml;base64,');"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Form -->
      <div class="scroll-reveal">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-0.5 bg-brand-primary"></div>
          <span class="text-brand-primary font-body font-bold text-xs tracking-[0.25em] uppercase">Get In Touch</span>
        </div>
        <h2 class="font-heading font-black text-white uppercase leading-[0.95] tracking-tight mb-8" style="font-size: clamp(2rem, 5vw, 3rem);">
          Request a Quote
        </h2>

        <form class="space-y-5">
          <div>
            <label class="block font-body text-white/60 text-xs uppercase tracking-wider mb-2 font-bold">Your Name</label>
            <input type="text" name="name" required class="w-full bg-white/5 border border-white/15 text-white px-4 py-3 font-body focus:border-brand-primary focus:outline-none transition-colors placeholder:text-white/30" placeholder="John Smith" />
          </div>
          <div>
            <label class="block font-body text-white/60 text-xs uppercase tracking-wider mb-2 font-bold">Phone Number</label>
            <input type="tel" name="phone" required class="w-full bg-white/5 border border-white/15 text-white px-4 py-3 font-body focus:border-brand-primary focus:outline-none transition-colors placeholder:text-white/30" placeholder="07XXX XXXXXX" />
          </div>
          <div>
            <label class="block font-body text-white/60 text-xs uppercase tracking-wider mb-2 font-bold">Postcode</label>
            <input type="text" name="postcode" class="w-full bg-white/5 border border-white/15 text-white px-4 py-3 font-body focus:border-brand-primary focus:outline-none transition-colors placeholder:text-white/30" placeholder="SO15 1AA" />
          </div>
          <div>
            <label class="block font-body text-white/60 text-xs uppercase tracking-wider mb-2 font-bold">Description of Work</label>
            <textarea name="description" rows="4" class="w-full bg-white/5 border border-white/15 text-white px-4 py-3 font-body focus:border-brand-primary focus:outline-none transition-colors placeholder:text-white/30 resize-none" placeholder="Tell us about the job..."></textarea>
          </div>
          <button type="submit" class="w-full bg-brand-primary hover:bg-red-700 text-white py-4 font-heading font-black text-base tracking-wider uppercase transition-all duration-300 hover:shadow-[0_8px_30px_rgba(198,40,40,0.4)] hover:translate-y-[-2px]" style="clip-path: polygon(0 0, 100% 0, 99% 100%, 1% 100%);">
            Send Request
          </button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="scroll-reveal lg:pl-8" style="animation-delay: 0.2s;">
        <div class="space-y-8 lg:mt-20">
          <!-- Phone -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-primary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <div class="font-heading font-black text-white text-sm uppercase tracking-wider mb-1">Phone</div>
              <a href="tel:02381112994" class="text-brand-accent/80 font-body text-lg hover:text-brand-primary transition-colors">02381 11 2994</a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-primary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <div class="font-heading font-black text-white text-sm uppercase tracking-wider mb-1">Email</div>
              <a href="mailto:kyle@kjp-plumbing-southampton.co.uk" class="text-brand-accent/80 font-body text-base hover:text-brand-primary transition-colors break-all">kyle@kjp-plumbing-southampton.co.uk</a>
            </div>
          </div>

          <!-- Address -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-primary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <div class="font-heading font-black text-white text-sm uppercase tracking-wider mb-1">Address</div>
              <p class="text-brand-accent/80 font-body text-base leading-relaxed">4 Broadleaf Close, Dibden Purlieu,<br />Southampton SO45 4AY</p>
            </div>
          </div>

          <!-- Emergency callout box -->
          <div class="bg-brand-primary/10 border border-brand-primary/30 p-6 mt-8">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-3 h-3 bg-brand-primary rounded-full animate-pulse"></div>
              <span class="font-heading font-black text-brand-primary text-sm uppercase tracking-wider">24/7 Emergency</span>
            </div>
            <p class="text-white/70 font-body text-sm mb-4">Got an emergency? We're available around the clock for urgent plumbing issues.</p>
            <a href="tel:02381112994" class="inline-flex items-center gap-2 text-white font-heading font-black text-lg">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              02381 11 2994
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hazard-stripe-red {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-brand-primary),
      var(--color-brand-primary) 8px,
      var(--color-brand-secondary) 8px,
      var(--color-brand-secondary) 16px
    );
  }
</style>
