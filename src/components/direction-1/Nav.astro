---
/**
 * Navigation — sticky, industrial, sharp edges.
 * Hazard stripe accent line under nav. Logo left, phone right.
 */
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <!-- Hazard stripe bar (motif #1) -->
  <div class="hazard-stripe h-1.5"></div>

  <div class="nav-inner bg-brand-secondary/95 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/redesign/logo.png" alt="KJP Plumbing & Heating" class="h-10 sm:h-12 w-auto" />
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="text-brand-accent/80 hover:text-white text-sm font-medium tracking-wide uppercase font-body transition-colors">Services</a>
        <a href="#reviews" class="text-brand-accent/80 hover:text-white text-sm font-medium tracking-wide uppercase font-body transition-colors">Reviews</a>
        <a href="#faq" class="text-brand-accent/80 hover:text-white text-sm font-medium tracking-wide uppercase font-body transition-colors">FAQs</a>
        <a href="#contact" class="text-brand-accent/80 hover:text-white text-sm font-medium tracking-wide uppercase font-body transition-colors">Contact</a>
      </div>

      <!-- Phone CTA -->
      <a href="tel:02381112994" class="hidden sm:flex items-center gap-2 bg-brand-primary hover:bg-red-700 text-white px-5 py-2.5 font-heading font-black text-sm tracking-wider uppercase transition-all hover:scale-[1.03]" style="clip-path: polygon(0 0, 100% 0, 96% 100%, 4% 100%);">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        02381 11 2994
      </a>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2" aria-label="Menu">
        <svg class="w-7 h-7 hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="w-7 h-7 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-brand-secondary border-t border-white/10">
    <div class="px-4 py-4 space-y-1">
      <a href="#services" class="block py-3 text-brand-accent font-heading font-black text-lg uppercase tracking-wider border-b border-white/5">Services</a>
      <a href="#reviews" class="block py-3 text-brand-accent font-heading font-black text-lg uppercase tracking-wider border-b border-white/5">Reviews</a>
      <a href="#faq" class="block py-3 text-brand-accent font-heading font-black text-lg uppercase tracking-wider border-b border-white/5">FAQs</a>
      <a href="#contact" class="block py-3 text-brand-accent font-heading font-black text-lg uppercase tracking-wider border-b border-white/5">Contact</a>
      <a href="tel:02381112994" class="block mt-4 bg-brand-primary text-white text-center py-3 font-heading font-black text-lg tracking-wider uppercase">
        Call 02381 11 2994
      </a>
    </div>
  </div>
</nav>

<style>
  .hazard-stripe {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-brand-primary),
      var(--color-brand-primary) 8px,
      var(--color-brand-secondary) 8px,
      var(--color-brand-secondary) 16px
    );
  }

  .nav-scrolled {
    box-shadow: 0 4px 30px rgba(0,0,0,0.3);
  }
  .nav-scrolled .nav-inner {
    background: rgba(30, 30, 42, 0.98);
  }
</style>

<script>
  // Scroll behavior
  const nav = document.getElementById('main-nav');
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 60) nav?.classList.add('nav-scrolled');
    else nav?.classList.remove('nav-scrolled');
    lastScroll = y;
  });

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    btn.querySelector('.hamburger-icon')?.classList.toggle('hidden');
    btn.querySelector('.close-icon')?.classList.toggle('hidden');
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.querySelector('.hamburger-icon')?.classList.remove('hidden');
      btn?.querySelector('.close-icon')?.classList.add('hidden');
    });
  });
</script>
