---
/**
 * Services — 6 cards on dark graphite background with service icons.
 * Alternating accent colors per card. Sharp edges. Hover with spring bounce.
 */
const services = [
  { title: 'Bathroom Installations', subtitle: 'Bathroom Fitting', icon: '/images/redesign/image-02.png', accent: '#C62828' },
  { title: 'Power Flushing', subtitle: 'Powerflushing', icon: '/images/redesign/image-03.png', accent: '#E65100' },
  { title: 'Plumbing & Heating', subtitle: 'Plumbing Services', icon: '/images/redesign/image-04.png', accent: '#C62828' },
  { title: 'Hot Water Faults', subtitle: 'Hot Water & Heating', icon: '/images/redesign/image-05.png', accent: '#E65100' },
  { title: 'Emergency Plumbing', subtitle: '24/7 Emergency Plumber', icon: '/images/redesign/image-06.png', accent: '#C62828' },
  { title: 'Tiling', subtitle: 'Professional Tiling', icon: null, accent: '#E65100' },
];
---

<section id="services" class="relative bg-brand-secondary py-20 sm:py-28 overflow-hidden">
  <!-- Noise texture -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml;base64,');"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-14">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="w-8 h-0.5 bg-brand-primary"></div>
        <span class="text-brand-primary font-body font-bold text-xs tracking-[0.25em] uppercase">What We Do</span>
        <div class="w-8 h-0.5 bg-brand-primary"></div>
      </div>
      <h2 class="font-heading font-black text-white uppercase leading-[0.95] tracking-tight" style="font-size: clamp(2rem, 5vw, 3.5rem);">
        Our Services
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div
          class="service-card group relative bg-white/5 border border-white/10 p-6 sm:p-8 transition-all duration-300 hover:bg-white/10 hover:border-white/20 cursor-pointer scroll-reveal"
          style={`--card-accent: ${service.accent}; animation-delay: ${i * 0.1}s;`}
        >
          <!-- Top accent bar (motif #5 - per card) -->
          <div class="absolute top-0 left-0 right-0 h-1" style={`background: ${service.accent};`}></div>

          <!-- Icon -->
          <div class="w-16 h-16 mb-5 flex items-center justify-center transition-transform duration-500 group-hover:scale-110" style="transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);">
            {service.icon ? (
              <img src={service.icon} alt={service.title} class="w-full h-full object-contain" />
            ) : (
              <svg class="w-10 h-10 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
            )}
          </div>

          <!-- Text -->
          <h3 class="font-heading font-black text-white text-xl uppercase tracking-wide mb-2">{service.title}</h3>
          <p class="text-white/50 font-body text-sm">{service.subtitle}</p>

          <!-- Arrow -->
          <div class="absolute bottom-6 right-6 opacity-0 translate-x-[-8px] transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0">
            <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom angled divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg class="w-full h-12 sm:h-16 text-brand-bg" viewBox="0 0 1440 64" preserveAspectRatio="none">
      <path fill="currentColor" d="M0,48 L1440,0 L1440,64 L0,64 Z"/>
    </svg>
  </div>
</section>
