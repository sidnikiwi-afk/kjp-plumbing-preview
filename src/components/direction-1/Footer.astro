---
/**
 * Footer — contact info, social links, trust badges.
 */
---

<footer class="bg-brand-secondary border-t border-white/10">
  <!-- Trust badges bar -->
  <div class="border-b border-white/5 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-8 h-0.5 bg-brand-primary"></div>
        <span class="text-brand-primary font-body font-bold text-xs tracking-[0.25em] uppercase">Trusted & Verified</span>
        <div class="w-8 h-0.5 bg-brand-primary"></div>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-8 text-white/40 font-body text-sm">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          Google Reviews
        </div>
        <div>MyWorkman Verified</div>
        <div>ProvenExpert</div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          UK Enterprise Awards — 5 Years Running
        </div>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Brand -->
      <div>
        <img src="/images/redesign/logo.png" alt="KJP Plumbing & Heating" class="h-10 w-auto mb-4" />
        <p class="text-white/50 font-body text-sm leading-relaxed">Professional Plumbing & Heating Services in Southampton & surrounding areas.</p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading font-black text-white text-sm uppercase tracking-wider mb-4">Services</h4>
        <ul class="space-y-2 font-body text-white/50 text-sm">
          <li>Bathroom Installations</li>
          <li>Power Flushing</li>
          <li>Plumbing & Heating</li>
          <li>Hot Water Faults</li>
          <li>Emergency Plumbing</li>
          <li>Tiling</li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-heading font-black text-white text-sm uppercase tracking-wider mb-4">Contact</h4>
        <ul class="space-y-2 font-body text-white/50 text-sm">
          <li><a href="tel:02381112994" class="hover:text-brand-primary transition-colors">02381 11 2994</a></li>
          <li><a href="mailto:kyle@kjp-plumbing-southampton.co.uk" class="hover:text-brand-primary transition-colors break-all">kyle@kjp-plumbing-southampton.co.uk</a></li>
          <li>4 Broadleaf Close, Dibden Purlieu, Southampton SO45 4AY</li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="font-heading font-black text-white text-sm uppercase tracking-wider mb-4">Follow Us</h4>
        <div class="flex gap-3">
          <a href="#" class="w-10 h-10 bg-white/5 hover:bg-brand-primary flex items-center justify-center text-white/50 hover:text-white transition-all duration-300" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/5 hover:bg-brand-primary flex items-center justify-center text-white/50 hover:text-white transition-all duration-300" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/5 hover:bg-brand-primary flex items-center justify-center text-white/50 hover:text-white transition-all duration-300" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/5 hover:bg-brand-primary flex items-center justify-center text-white/50 hover:text-white transition-all duration-300" aria-label="Threads">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.59 12c.025 3.086.718 5.496 2.057 7.164 1.432 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.751-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.187.408-2.26 1.33-3.019.88-.724 2.107-1.127 3.456-1.136.93-.006 1.802.132 2.6.413-.028-1.763-.654-3.078-1.855-3.182-.066-.005-.132-.008-.2-.008-1.16 0-2.086.453-2.754 1.347l-1.628-1.164C9.456 5.748 10.752 5.01 12.37 5.01c.09 0 .18.002.27.007 2.126.166 3.395 1.848 3.556 4.473.477.173.91.386 1.297.645 1.062.708 1.856 1.67 2.3 2.786.785 1.97.604 4.662-1.435 6.66-1.745 1.712-3.904 2.446-6.99 2.466h-.003l.002-.047zm-1.25-8.086c-.95.006-1.7.222-2.233.643-.476.375-.7.862-.67 1.449.031.563.34 1.065.87 1.41.6.389 1.388.577 2.218.53 1.075-.058 1.895-.46 2.437-1.197.36-.49.617-1.12.755-1.876a7.328 7.328 0 00-3.377-.96z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <p class="text-white/30 font-body text-xs text-center">&copy; 2026 KJP Plumbing & Heating. All rights reserved.</p>
    </div>
  </div>
</footer>
