---
/**
 * Sticky mobile emergency CTA bar — bottom of screen on mobile only.
 * Hazard stripe accent.
 */
---

<div id="mobile-cta" class="fixed bottom-0 left-0 right-0 z-50 sm:hidden translate-y-full transition-transform duration-300">
  <!-- Hazard stripe top (motif reuse) -->
  <div class="h-1 hazard-mobile"></div>
  <div class="bg-brand-secondary/98 backdrop-blur-md border-t border-white/10 px-4 py-3 flex items-center justify-between gap-3">
    <a href="tel:02381112994" class="flex-1 flex items-center justify-center gap-2 bg-brand-primary text-white py-3 font-heading font-black text-sm tracking-wider uppercase">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      Call Now
    </a>
    <a href="#contact" class="flex-1 flex items-center justify-center gap-2 border border-white/20 text-white py-3 font-heading font-black text-sm tracking-wider uppercase">
      Get Quote
    </a>
  </div>
</div>

<style>
  .hazard-mobile {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-brand-primary),
      var(--color-brand-primary) 6px,
      var(--color-brand-secondary) 6px,
      var(--color-brand-secondary) 12px
    );
  }

  #mobile-cta.visible {
    transform: translateY(0);
  }
</style>

<script>
  const mobileCta = document.getElementById('mobile-cta');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      mobileCta?.classList.add('visible');
    } else {
      mobileCta?.classList.remove('visible');
    }
  });
</script>
