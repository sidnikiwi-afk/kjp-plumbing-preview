---
---
<section class="relative min-h-screen flex items-center overflow-hidden bg-brand-bg blueprint-grid">
  <!-- Blueprint grid overlay -->
  <div class="absolute inset-0 blueprint-pattern opacity-[0.04] pointer-events-none"></div>

  <!-- Crosshair decorations -->
  <div class="absolute top-32 right-24 crosshair opacity-20 hidden lg:block"></div>
  <div class="absolute bottom-40 left-16 crosshair opacity-15 hidden lg:block"></div>

  <!-- Measurement marks along left edge -->
  <div class="absolute left-8 top-1/4 hidden lg:flex flex-col gap-6 items-center opacity-15">
    <div class="w-px h-16 bg-brand-primary"></div>
    <span class="font-mono text-[10px] text-brand-primary -rotate-90 whitespace-nowrap">SEC.01</span>
    <div class="w-px h-16 bg-brand-primary"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28 relative z-10 w-full">
    <!-- Micro label -->
    <div class="flex items-center gap-3 mb-6 hero-stagger" style="--delay: 0">
      <div class="h-px w-8 bg-brand-primary"></div>
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-brand-primary font-medium">Southampton's Trusted Plumber</span>
    </div>

    <!-- Massive headline -->
    <h1 class="hero-stagger" style="--delay: 1">
      <span class="block font-heading font-bold text-brand-text leading-[0.9] tracking-[-0.03em]" style="font-size: clamp(2.8rem, 8vw, 6rem);">
        Local Plumber In
      </span>
      <span class="block font-heading font-bold text-brand-primary leading-[0.9] tracking-[-0.03em] mt-1" style="font-size: clamp(2.8rem, 8vw, 6rem);">
        Southampton
      </span>
      <span class="block font-heading font-medium text-brand-muted leading-[0.95] tracking-[-0.02em] mt-2" style="font-size: clamp(1.4rem, 3.5vw, 2.4rem);">
        & Emergency Plumbing Services
      </span>
    </h1>

    <!-- Subtext -->
    <p class="max-w-xl text-brand-muted text-base md:text-lg leading-relaxed mt-8 font-body hero-stagger" style="--delay: 2">
      Professional Plumbing & Heating Services & Emergency Plumber in Southampton & The Local Surrounding Areas.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center gap-4 mt-10 hero-stagger" style="--delay: 3">
      <a href="#contact" class="inline-flex items-center gap-2 bg-brand-accent text-brand-secondary font-bold py-3.5 px-8 rounded-full text-sm tracking-wide hover:scale-105 hover:shadow-lg hover:shadow-brand-accent/25 transition-all duration-200">
        Request a Quote
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <a href="tel:02381112994" class="inline-flex items-center gap-2 border-2 border-brand-primary/20 text-brand-primary font-bold py-3.5 px-8 rounded-full text-sm tracking-wide hover:border-brand-primary hover:bg-brand-primary/5 transition-all duration-200">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span class="font-mono">02381 11 2994</span>
      </a>
    </div>

    <!-- Trust pills -->
    <div class="flex flex-wrap items-center gap-3 mt-10 hero-stagger" style="--delay: 4">
      <span class="inline-flex items-center gap-1.5 bg-brand-surface text-brand-muted text-xs font-medium py-1.5 px-4 rounded-full border border-brand-primary/5">
        <svg class="w-3.5 h-3.5 text-brand-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
        25+ Years
      </span>
      <span class="inline-flex items-center gap-1.5 bg-brand-surface text-brand-muted text-xs font-medium py-1.5 px-4 rounded-full border border-brand-primary/5">
        <svg class="w-3.5 h-3.5 text-brand-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
        24/7 Emergency
      </span>
      <span class="inline-flex items-center gap-1.5 bg-brand-surface text-brand-muted text-xs font-medium py-1.5 px-4 rounded-full border border-brand-primary/5">
        <svg class="w-3.5 h-3.5 text-brand-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
        Powerflush Specialists
      </span>
    </div>
  </div>
</section>

<style>
  .blueprint-pattern {
    background-image:
      linear-gradient(var(--color-brand-primary) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-brand-primary) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .crosshair {
    width: 40px;
    height: 40px;
    position: relative;
  }
  .crosshair::before,
  .crosshair::after {
    content: '';
    position: absolute;
    background: var(--color-brand-primary);
  }
  .crosshair::before {
    width: 1px;
    height: 100%;
    left: 50%;
  }
  .crosshair::after {
    height: 1px;
    width: 100%;
    top: 50%;
  }

  .hero-stagger {
    opacity: 0;
    transform: translateY(24px);
    animation: hero-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--delay) * 0.12s + 0.2s);
  }

  @keyframes hero-in {
    0% { opacity: 0; transform: translateY(24px); }
    70% { transform: translateY(-3px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>
