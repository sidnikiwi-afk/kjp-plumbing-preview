<section class="relative py-20 md:py-28 bg-brand-primary overflow-hidden">
  <!-- Blueprint pattern on blue -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.08]" style="background-image: linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <!-- Connection dots -->
  <div class="absolute top-1/2 left-8 -translate-y-1/2 hidden lg:flex flex-col gap-4 opacity-20">
    <div class="w-2 h-2 rounded-full bg-white"></div>
    <div class="w-2 h-2 rounded-full bg-white"></div>
    <div class="w-2 h-2 rounded-full bg-white"></div>
  </div>
  <div class="absolute top-1/2 right-8 -translate-y-1/2 hidden lg:flex flex-col gap-4 opacity-20">
    <div class="w-2 h-2 rounded-full bg-white"></div>
    <div class="w-2 h-2 rounded-full bg-white"></div>
    <div class="w-2 h-2 rounded-full bg-white"></div>
  </div>

  <div class="max-w-3xl mx-auto px-6 text-center relative z-10">
    <span class="inline-block font-mono text-xs tracking-[0.2em] uppercase text-white/60 mb-4">Ready to get started?</span>
    <h2 class="font-heading font-bold text-white tracking-tight leading-tight mb-6" style="font-size: clamp(2rem, 5vw, 3.5rem);">Need a Plumber in Southampton?</h2>
    <p class="text-white/70 text-base md:text-lg leading-relaxed mb-10 max-w-lg mx-auto">Call us today for a free, no-obligation quote. Emergency callouts available 24/7.</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#contact" class="inline-flex items-center gap-2 bg-brand-accent text-brand-secondary font-bold py-4 px-10 rounded-full text-sm tracking-wide hover:scale-105 hover:shadow-lg hover:shadow-black/20 transition-all duration-200">
        Request a Quote
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <a href="tel:02381112994" class="inline-flex items-center gap-2 border-2 border-white/30 text-white font-bold py-4 px-10 rounded-full text-sm tracking-wide hover:bg-white/10 hover:border-white/50 transition-all duration-200">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span class="font-mono">02381 11 2994</span>
      </a>
    </div>
  </div>
</section>
