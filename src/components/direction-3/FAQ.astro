---
const faqs = [
  { q: 'How Far Do You Travel?', a: 'We cover all Southampton postcodes. We may travel further afield for specialist works only.' },
  { q: 'What Are Your Prices?', a: 'Approximately &pound;75/hr for Plumbing, &pound;90 for Internal Drainage, and &pound;120 for External Drainage.' },
  { q: 'How Do I Pay?', a: 'We accept cash, Visa, Mastercard, debit/credit cards, and bank transfer.' },
  { q: 'Do You Offer Emergency Services?', a: 'Yes, we provide 24/7 emergency plumbing services across Southampton and surrounding areas.' },
  { q: 'What Is Powerflushing?', a: 'Powerflushing removes sludge, rust, and debris from your heating system. It improves efficiency, reduces energy bills, and extends the life of your boiler.' },
  { q: 'Do You Offer Free Quotes?', a: 'Yes, we provide free no-obligation quotes for all plumbing and heating services.' },
];
---
<section id="faq" class="relative py-24 md:py-32 bg-brand-surface">
  <!-- Dot grid -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.025]" style="background-image: radial-gradient(var(--color-brand-primary) 1px, transparent 1px); background-size: 24px 24px;"></div>

  <div class="max-w-3xl mx-auto px-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-px w-8 bg-brand-primary"></div>
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-brand-primary font-medium">FAQ</span>
    </div>
    <h2 class="font-heading font-bold text-brand-text tracking-tight leading-tight mb-12" style="font-size: clamp(2rem, 4vw, 3rem);">Common Questions</h2>

    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <details class="faq-item group bg-white rounded-xl border border-brand-primary/5 hover:border-brand-primary/15 transition-colors">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none select-none">
            <span class="font-heading font-semibold text-brand-text text-sm md:text-base pr-4">{faq.q}</span>
            <span class="shrink-0 w-6 h-6 rounded-full bg-brand-primary/5 flex items-center justify-center group-open:bg-brand-primary group-open:text-white text-brand-primary transition-all duration-200">
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/></svg>
            </span>
          </summary>
          <div class="px-5 pb-5 -mt-1">
            <p class="text-brand-muted text-sm leading-relaxed" set:html={faq.a}></p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
