---
---
<nav id="bp-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="flex items-center gap-3">
      <img src="/images/redesign/logo.png" alt="KJP Plumbing" class="h-10 w-auto" />
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#services" class="nav-link text-sm font-medium tracking-wide uppercase text-brand-muted hover:text-brand-primary transition-colors">Services</a>
      <a href="#reviews" class="nav-link text-sm font-medium tracking-wide uppercase text-brand-muted hover:text-brand-primary transition-colors">Reviews</a>
      <a href="#faq" class="nav-link text-sm font-medium tracking-wide uppercase text-brand-muted hover:text-brand-primary transition-colors">FAQ</a>
      <a href="#contact" class="nav-link text-sm font-medium tracking-wide uppercase text-brand-muted hover:text-brand-primary transition-colors">Contact</a>
    </div>

    <a href="tel:02381112994" class="hidden md:flex items-center gap-2 font-mono text-brand-primary font-bold text-lg tracking-tight hover:text-brand-accent transition-colors">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-accent"></span>
      </span>
      02381 11 2994
    </a>

    <!-- Mobile menu button -->
    <button id="bp-menu-toggle" class="md:hidden p-2 text-brand-text" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="bp-mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-brand-primary/10 px-6 pb-6">
    <div class="flex flex-col gap-4 pt-4">
      <a href="#services" class="mobile-link text-sm font-medium tracking-wide uppercase text-brand-muted">Services</a>
      <a href="#reviews" class="mobile-link text-sm font-medium tracking-wide uppercase text-brand-muted">Reviews</a>
      <a href="#faq" class="mobile-link text-sm font-medium tracking-wide uppercase text-brand-muted">FAQ</a>
      <a href="#contact" class="mobile-link text-sm font-medium tracking-wide uppercase text-brand-muted">Contact</a>
      <a href="tel:02381112994" class="mt-2 inline-flex items-center justify-center gap-2 bg-brand-accent text-brand-secondary font-bold py-3 px-6 rounded-full text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call Now
      </a>
    </div>
  </div>
</nav>

<script>
  // Scroll effect
  const nav = document.getElementById('bp-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      nav?.classList.add('bg-white/90', 'backdrop-blur-xl', 'shadow-sm');
    } else {
      nav?.classList.remove('bg-white/90', 'backdrop-blur-xl', 'shadow-sm');
    }
  });

  // Mobile toggle
  const toggle = document.getElementById('bp-menu-toggle');
  const menu = document.getElementById('bp-mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
