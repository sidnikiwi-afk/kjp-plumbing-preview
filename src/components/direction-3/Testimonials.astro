---
const reviews = [
  { text: "Excellent work carried out by these guys, very happy with how quickly everything was fixed and back to normal.", name: "Lyn Gardner", location: "Sholing", stars: 5 },
  { text: "Fantastic service from start to finish! I booked KJP Plumbing for a powerflush service in Southampton and the difference it made to my heating system was incredible.", name: "Sidney Hanson", location: "Hythe", stars: 5 },
  { text: "Would recommend to all my friends 100%. Came out to an emergency early hours and couldn't be happier with the outcome.", name: "Craig Teal", location: "Totton", stars: 5 },
  { text: "The quality of workmanship he does is always excellent. He works professionally and very reliable.", name: "Roi Rozano Gammad", location: "", stars: 5 },
  { text: "Would HIGHLY recommend Kyle! Great and quick communication from the start, explained everything that needed to be done and very reasonable priced.", name: "Kerry P", location: "", stars: 5 },
  { text: "Highly recommend KJP Plumbing & Heating. I had a leaking shower into the downstairs ceiling and found KJP from several recommendations.", name: "Charlie S", location: "", stars: 5 },
];
---
<section id="reviews" class="relative py-24 md:py-32 bg-brand-surface overflow-hidden">
  <!-- Blueprint grid accent -->
  <div class="absolute inset-0 blueprint-lines opacity-[0.025] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-px w-8 bg-brand-primary"></div>
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-brand-primary font-medium">Verified Reviews</span>
    </div>
    <h2 class="font-heading font-bold text-brand-text tracking-tight leading-tight mb-16" style="font-size: clamp(2rem, 4vw, 3rem);">What Our Customers Say</h2>

    <!-- Asymmetric masonry-style layout - THIS IS THE GRID BREAK -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 auto-rows-auto">
      <!-- Large featured card - spans more -->
      <div class="review-card md:col-span-7 bg-white rounded-2xl p-8 border border-brand-primary/5 relative group hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300" style="--r-delay: 0s">
        <div class="absolute top-4 right-4 font-mono text-[10px] text-brand-primary/20 tracking-widest">01</div>
        <div class="flex gap-1 mb-4">
          {Array.from({length: 5}).map(() => (
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <blockquote class="text-brand-text text-lg md:text-xl leading-relaxed mb-6 font-body">"{reviews[0].text}"</blockquote>
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary font-heading font-bold text-sm">{reviews[0].name[0]}</div>
          <div>
            <div class="font-heading font-semibold text-sm text-brand-text">{reviews[0].name}</div>
            {reviews[0].location && <div class="text-xs text-brand-muted">{reviews[0].location}</div>}
          </div>
        </div>
      </div>

      <!-- Smaller card -->
      <div class="review-card md:col-span-5 bg-white rounded-2xl p-6 border border-brand-primary/5 relative group hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300" style="--r-delay: 0.08s">
        <div class="absolute top-4 right-4 font-mono text-[10px] text-brand-primary/20 tracking-widest">02</div>
        <div class="flex gap-1 mb-3">
          {Array.from({length: 5}).map(() => (
            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <blockquote class="text-brand-text text-sm leading-relaxed mb-4">"{reviews[1].text}"</blockquote>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary font-heading font-bold text-xs">{reviews[1].name[0]}</div>
          <div>
            <div class="font-heading font-semibold text-xs text-brand-text">{reviews[1].name}</div>
            {reviews[1].location && <div class="text-[11px] text-brand-muted">{reviews[1].location}</div>}
          </div>
        </div>
      </div>

      <!-- Row 2: 5-5-2 split with overlap -->
      <div class="review-card md:col-span-5 bg-white rounded-2xl p-6 border border-brand-primary/5 relative group hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300 md:-mt-4" style="--r-delay: 0.16s">
        <div class="absolute top-4 right-4 font-mono text-[10px] text-brand-primary/20 tracking-widest">03</div>
        <div class="flex gap-1 mb-3">
          {Array.from({length: 5}).map(() => (
            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <blockquote class="text-brand-text text-sm leading-relaxed mb-4">"{reviews[2].text}"</blockquote>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary font-heading font-bold text-xs">{reviews[2].name[0]}</div>
          <div>
            <div class="font-heading font-semibold text-xs text-brand-text">{reviews[2].name}</div>
            {reviews[2].location && <div class="text-[11px] text-brand-muted">{reviews[2].location}</div>}
          </div>
        </div>
      </div>

      <div class="review-card md:col-span-4 bg-white rounded-2xl p-6 border border-brand-primary/5 relative group hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300" style="--r-delay: 0.24s">
        <div class="absolute top-4 right-4 font-mono text-[10px] text-brand-primary/20 tracking-widest">04</div>
        <div class="flex gap-1 mb-3">
          {Array.from({length: 5}).map(() => (
            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <blockquote class="text-brand-text text-sm leading-relaxed mb-4">"{reviews[3].text}"</blockquote>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary font-heading font-bold text-xs">{reviews[3].name[0]}</div>
          <div class="font-heading font-semibold text-xs text-brand-text">{reviews[3].name}</div>
        </div>
      </div>

      <!-- Accent card with brand color -->
      <div class="review-card md:col-span-3 bg-brand-primary rounded-2xl p-6 relative group hover:shadow-xl hover:shadow-brand-primary/20 transition-all duration-300 md:-mt-6" style="--r-delay: 0.32s">
        <div class="absolute top-4 right-4 font-mono text-[10px] text-white/30 tracking-widest">05</div>
        <div class="flex gap-1 mb-3">
          {Array.from({length: 5}).map(() => (
            <svg class="w-3.5 h-3.5 text-amber-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <blockquote class="text-white/90 text-sm leading-relaxed mb-4">"{reviews[4].text}"</blockquote>
        <div class="font-heading font-semibold text-xs text-white">{reviews[4].name}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .blueprint-lines {
    background-image:
      linear-gradient(var(--color-brand-primary) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-brand-primary) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .review-card {
    opacity: 0;
    transform: translateY(20px);
  }
  .review-card.visible {
    animation: review-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--r-delay);
  }
  @keyframes review-in {
    0% { opacity: 0; transform: translateY(20px); }
    70% { transform: translateY(-2px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.review-card').forEach(el => obs.observe(el));
</script>
