---
---

<!-- Copper pipe elbow SVG used as decorative motif -->
<nav id="copper-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out">
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between nav-inner">
    <a href="#" class="flex items-center gap-3 group">
      <img src="/images/redesign/logo.png" alt="KJP Plumbing & Heating" class="h-10 nav-logo transition-all duration-500" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#services" class="nav-link text-sm tracking-wide font-body text-brand-primary/80 hover:text-brand-secondary transition-colors duration-300">Services</a>
      <a href="#testimonials" class="nav-link text-sm tracking-wide font-body text-brand-primary/80 hover:text-brand-secondary transition-colors duration-300">Reviews</a>
      <a href="#gallery" class="nav-link text-sm tracking-wide font-body text-brand-primary/80 hover:text-brand-secondary transition-colors duration-300">Gallery</a>
      <a href="#faqs" class="nav-link text-sm tracking-wide font-body text-brand-primary/80 hover:text-brand-secondary transition-colors duration-300">FAQs</a>
      <a href="#contact" class="nav-link text-sm tracking-wide font-body text-brand-primary/80 hover:text-brand-secondary transition-colors duration-300">Contact</a>

      <!-- Pipe elbow divider -->
      <svg class="pipe-elbow w-5 h-5 text-brand-secondary/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M4 4 L4 14 Q4 20 10 20 L20 20" />
      </svg>

      <a href="tel:02381112994" class="copper-cta inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium text-white transition-all duration-300 hover:scale-[1.03] hover:shadow-lg">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        02381 11 2994
      </a>
    </div>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
      <span class="w-6 h-0.5 bg-brand-primary transition-all duration-300 origin-center mobile-bar-1"></span>
      <span class="w-6 h-0.5 bg-brand-primary transition-all duration-300 mobile-bar-2"></span>
      <span class="w-4 h-0.5 bg-brand-secondary transition-all duration-300 origin-center mobile-bar-3"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden mobile-menu-closed overflow-hidden transition-all duration-500 ease-out bg-brand-bg/98 backdrop-blur-xl border-t border-brand-secondary/10">
    <div class="px-6 py-6 flex flex-col gap-4">
      <a href="#services" class="mobile-nav-link text-lg font-heading text-brand-primary">Services</a>
      <a href="#testimonials" class="mobile-nav-link text-lg font-heading text-brand-primary">Reviews</a>
      <a href="#gallery" class="mobile-nav-link text-lg font-heading text-brand-primary">Gallery</a>
      <a href="#faqs" class="mobile-nav-link text-lg font-heading text-brand-primary">FAQs</a>
      <a href="#contact" class="mobile-nav-link text-lg font-heading text-brand-primary">Contact</a>
      <a href="tel:02381112994" class="copper-cta inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-base font-medium text-white mt-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        Call Now
      </a>
    </div>
  </div>
</nav>

<style>
  @reference "../../styles/global.css";

  #copper-nav {
    background: rgba(250, 248, 245, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #copper-nav.nav-scrolled {
    background: rgba(250, 248, 245, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 20px rgba(15, 25, 35, 0.06);
  }

  #copper-nav.nav-scrolled .nav-inner {
    @apply py-3;
  }

  #copper-nav.nav-scrolled .nav-logo {
    @apply h-8;
  }

  .copper-cta {
    background: linear-gradient(135deg, #C67D4A 0%, #D4945F 50%, #B8693A 100%);
    box-shadow: 0 2px 12px rgba(198, 125, 74, 0.3);
  }

  .copper-cta:hover {
    box-shadow: 0 4px 20px rgba(198, 125, 74, 0.45);
  }

  .mobile-menu-closed {
    max-height: 0;
    opacity: 0;
  }

  .mobile-menu-open {
    max-height: 400px;
    opacity: 1;
  }

  .nav-inner {
    transition: padding 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('mobile-menu-closed');
      menu.classList.toggle('mobile-menu-open');
    });
    // Close on link click
    menu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        menu.classList.add('mobile-menu-closed');
        menu.classList.remove('mobile-menu-open');
      });
    });
  }
</script>
