---
const testimonials = [
  { quote: "Excellent work carried out by these guys, very happy with how quickly everything was fixed and back to normal.", name: "Lyn Gardner", location: "Sholing" },
  { quote: "Fantastic service from start to finish! I booked KJP Plumbing for a powerflush service in Southampton and the difference it made to my heating system was incredible. Kyle also fixed a long-standing radiator issue on the spot.", name: "Sidney Hanson", location: "Hythe" },
  { quote: "Would recommend to all my friends 100%. Came out to an emergency early hours and couldn't be happier with the outcome.", name: "Craig Teal", location: "Totton" },
  { quote: "The quality of workmanship he does is always excellent. He works professionally and very reliable.", name: "Roi Rozano Gammad", location: "" },
  { quote: "Would HIGHLY recommend Kyle! Great and quick communication from the start, explained everything that needed to be done and very reasonable priced.", name: "Kerry P", location: "" },
  { quote: "Highly recommend KJP Plumbing & Heating. I had a leaking shower into the downstairs ceiling and found KJP from several recommendations.", name: "Charlie S", location: "" },
];
---

<section id="testimonials" class="bg-brand-primary relative py-24 lg:py-32 overflow-hidden">
  <!-- SVG curve at top -->
  <div class="absolute top-0 left-0 right-0">
    <svg viewBox="0 0 1440 50" fill="none" preserveAspectRatio="none" class="w-full h-[50px]">
      <path d="M0 0 L0 20 Q720 50 1440 20 L1440 0 Z" fill="#FAF8F5"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 reveal">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <!-- Pipe elbow as quote mark -->
          <svg class="w-8 h-8 text-brand-secondary" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M6 6 L6 18 Q6 26 14 26 L26 26" />
          </svg>
          <span class="text-sm font-body tracking-[0.2em] uppercase text-brand-secondary/80">Testimonials</span>
        </div>
        <h2 class="font-heading text-white leading-tight tracking-[-0.01em]" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 600;">
          What Our <em class="text-brand-secondary not-italic" style="font-style: italic; font-weight: 400;">Customers</em> Say
        </h2>
      </div>

      <!-- Carousel controls -->
      <div class="flex gap-3 mt-6 md:mt-0">
        <button id="carousel-prev" class="w-11 h-11 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:text-brand-secondary hover:border-brand-secondary/40 transition-all duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        </button>
        <button id="carousel-next" class="w-11 h-11 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:text-brand-secondary hover:border-brand-secondary/40 transition-all duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        </button>
      </div>
    </div>

    <!-- Carousel track -->
    <div id="testimonial-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-4 -mx-6 px-6 reveal" style="scroll-padding-left: 24px;">
      {testimonials.map((t, i) => (
        <div class="testimonial-card flex-shrink-0 w-[340px] md:w-[380px] snap-start bg-white/[0.06] backdrop-blur-sm rounded-2xl p-7 border border-white/[0.08] transition-all duration-500 hover:bg-white/[0.1] hover:border-brand-secondary/20" style={`animation-delay: ${i * 100}ms`}>
          {/* Stars */}
          <div class="flex gap-0.5 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-brand-secondary" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>

          {/* Copper pipe as opening quote */}
          <svg class="w-5 h-5 text-brand-secondary/40 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 4 L4 12 Q4 16 8 16 L16 16" />
          </svg>

          <p class="font-body text-white/80 text-sm leading-relaxed mb-6">"{t.quote}"</p>

          <div class="flex items-center gap-3 pt-4 border-t border-white/[0.06]">
            <div class="w-9 h-9 rounded-full bg-brand-secondary/20 flex items-center justify-center">
              <span class="text-sm font-heading font-semibold text-brand-secondary">{t.name.charAt(0)}</span>
            </div>
            <div>
              <p class="font-heading text-white text-sm font-semibold">{t.name}</p>
              {t.location && <p class="font-body text-white/40 text-xs">{t.location}</p>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- SVG curve to next section -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 50" fill="none" preserveAspectRatio="none" class="w-full h-[50px]">
      <path d="M0 50 L0 30 Q720 0 1440 30 L1440 50 Z" fill="#FAF8F5"/>
    </svg>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
