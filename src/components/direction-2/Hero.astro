---
---

<section class="cream-texture relative overflow-hidden min-h-screen flex items-center pt-20">
  <!-- Decorative pipe lines connecting from top -->
  <svg class="absolute top-0 left-[12%] w-px h-32 text-brand-secondary/20" viewBox="0 0 2 128" fill="none">
    <line x1="1" y1="0" x2="1" y2="128" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6" class="hero-pipe-line" />
  </svg>

  <div class="max-w-7xl mx-auto px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-4 items-center min-h-[80vh]">

      <!-- Left: Text (45%) -->
      <div class="lg:col-span-5 relative z-10 py-12 lg:py-0">
        <!-- Pipe elbow accent before tagline -->
        <div class="flex items-center gap-3 mb-6 hero-stagger-1">
          <svg class="w-6 h-6 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M4 4 L4 14 Q4 20 10 20 L20 20" />
          </svg>
          <span class="text-sm font-body tracking-[0.2em] uppercase text-brand-secondary font-medium">Southampton's Trusted Plumber</span>
        </div>

        <h1 class="hero-stagger-2">
          <span class="block font-heading text-brand-primary leading-[1.05] tracking-[-0.02em]" style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700;">
            Local Plumber In
          </span>
          <span class="block font-heading leading-[1.05] tracking-[-0.02em]" style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700;">
            <em class="text-brand-secondary not-italic" style="font-style: italic; font-weight: 500;">Southampton</em>
          </span>
          <span class="block font-heading text-brand-primary leading-[1.05] tracking-[-0.02em] mt-1" style="font-size: clamp(1.4rem, 2.8vw, 2rem); font-weight: 400;">
            & Emergency Plumbing Services
          </span>
        </h1>

        <p class="mt-6 text-brand-muted font-body text-lg leading-relaxed max-w-md hero-stagger-3">
          Professional Plumbing & Heating Services & Emergency Plumber in Southampton & The Local Surrounding Areas.
        </p>

        <!-- Dual CTAs -->
        <div class="flex flex-wrap gap-4 mt-8 hero-stagger-4">
          <a href="#contact" class="copper-cta-hero inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-white font-medium transition-all duration-400 hover:scale-[1.03]">
            Request a Quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
          <a href="tel:02381112994" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border-2 border-brand-primary/15 text-brand-primary font-medium transition-all duration-300 hover:border-brand-secondary/40 hover:text-brand-secondary group">
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            Call Now
          </a>
        </div>

        <!-- Trust row -->
        <div class="flex items-center gap-4 mt-10 hero-stagger-5">
          <div class="flex items-center gap-1">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-brand-secondary" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="text-sm text-brand-muted font-body">5-Star Google Reviews</span>
          <span class="text-brand-muted/30">|</span>
          <span class="text-sm text-brand-muted font-body">25+ Years Experience</span>
        </div>
      </div>

      <!-- Right: Image (55%) - with subtle parallax -->
      <div class="lg:col-span-7 relative hero-image-container">
        <!-- Decorative pipe corner behind image -->
        <svg class="absolute -top-6 -left-6 w-16 h-16 text-brand-secondary/15 z-0" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
          <path d="M8 8 L8 40 Q8 56 24 56 L56 56" />
        </svg>

        <div class="relative z-10 hero-image-wrapper rounded-2xl overflow-hidden shadow-2xl shadow-brand-primary/10">
          <img
            src="/images/redesign/image-10.jpg"
            alt="Modern bathroom installation by KJP Plumbing Southampton"
            class="w-full h-[500px] lg:h-[600px] object-cover object-center hero-parallax"
            loading="eager"
          />
          <!-- Copper gradient overlay at bottom -->
          <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-brand-secondary/20 to-transparent z-20"></div>
        </div>

        <!-- Floating badge -->
        <div class="absolute -bottom-4 left-8 bg-white rounded-xl px-5 py-3 shadow-lg shadow-brand-primary/8 z-20 hero-stagger-5 flex items-center gap-3">
          <svg class="w-8 h-8 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
          </svg>
          <div>
            <p class="text-xs font-body text-brand-muted">UK Enterprise Awards</p>
            <p class="text-sm font-heading font-semibold text-brand-primary">5 Years Running</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SVG curve transition to next section -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-[60px]">
      <path d="M0 60 L0 20 Q360 0 720 20 Q1080 40 1440 20 L1440 60 Z" fill="#0F1923"/>
    </svg>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .copper-cta-hero {
    background: linear-gradient(135deg, #C67D4A 0%, #D4945F 50%, #B8693A 100%);
    box-shadow: 0 4px 20px rgba(198, 125, 74, 0.35);
  }
  .copper-cta-hero:hover {
    box-shadow: 0 6px 30px rgba(198, 125, 74, 0.5);
  }

  /* Staggered hero entrance */
  .hero-stagger-1 {
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .hero-stagger-2 {
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }
  .hero-stagger-3 {
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }
  .hero-stagger-4 {
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
  }
  .hero-stagger-5 {
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.0s both;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-image-wrapper {
    animation: heroImageReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  @keyframes heroImageReveal {
    from {
      opacity: 0;
      transform: translateX(40px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  /* Pipe line dash animation */
  .hero-pipe-line {
    animation: pipeDraw 2s ease-out 0.5s both;
    stroke-dashoffset: 128;
  }
  @keyframes pipeDraw {
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  // Subtle parallax on hero image
  const heroImg = document.querySelector('.hero-parallax') as HTMLElement;
  if (heroImg && window.innerWidth > 768) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY;
      heroImg.style.transform = `translateY(${scrolled * 0.08}px)`;
    }, { passive: true });
  }
</script>
