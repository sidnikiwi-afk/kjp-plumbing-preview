---
---

<section id="contact" class="bg-brand-primary relative py-24 lg:py-32 overflow-hidden">
  <!-- Decorative pipe lines -->
  <svg class="absolute top-20 left-[5%] w-px h-64 text-brand-secondary/10 hidden lg:block" viewBox="0 0 2 256" fill="none">
    <line x1="1" y1="0" x2="1" y2="256" stroke="currentColor" stroke-width="2" stroke-dasharray="4 8" />
  </svg>
  <svg class="absolute bottom-20 right-[5%] w-px h-48 text-brand-secondary/10 hidden lg:block" viewBox="0 0 2 192" fill="none">
    <line x1="1" y1="0" x2="1" y2="192" stroke="currentColor" stroke-width="2" stroke-dasharray="4 8" />
  </svg>

  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: Info -->
      <div class="reveal-left">
        <div class="flex items-center gap-3 mb-4">
          <svg class="w-6 h-6 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M4 4 L4 14 Q4 20 10 20 L20 20" />
          </svg>
          <span class="text-sm font-body tracking-[0.2em] uppercase text-brand-secondary/80">Get In Touch</span>
        </div>

        <h2 class="font-heading text-white leading-tight tracking-[-0.01em] mb-6" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 600;">
          Request a <em class="text-brand-secondary not-italic" style="font-style: italic; font-weight: 400;">Free Quote</em>
        </h2>

        <p class="font-body text-white/60 text-base leading-relaxed mb-10 max-w-md">
          Get in touch for a free, no-obligation quote. We cover Southampton and all surrounding areas.
        </p>

        <!-- Contact details -->
        <div class="space-y-5">
          <a href="tel:02381112994" class="flex items-center gap-4 group">
            <div class="w-11 h-11 rounded-xl bg-brand-secondary/15 flex items-center justify-center transition-colors duration-300 group-hover:bg-brand-secondary/25">
              <svg class="w-5 h-5 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            </div>
            <div>
              <p class="text-xs font-body text-white/40 uppercase tracking-wider">Phone</p>
              <p class="font-heading text-white font-medium">02381 11 2994</p>
            </div>
          </a>

          <a href="mailto:kyle@kjp-plumbing-southampton.co.uk" class="flex items-center gap-4 group">
            <div class="w-11 h-11 rounded-xl bg-brand-secondary/15 flex items-center justify-center transition-colors duration-300 group-hover:bg-brand-secondary/25">
              <svg class="w-5 h-5 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            </div>
            <div>
              <p class="text-xs font-body text-white/40 uppercase tracking-wider">Email</p>
              <p class="font-heading text-white font-medium text-sm">kyle@kjp-plumbing-southampton.co.uk</p>
            </div>
          </a>

          <div class="flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-brand-secondary/15 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            </div>
            <div>
              <p class="text-xs font-body text-white/40 uppercase tracking-wider">Address</p>
              <p class="font-heading text-white font-medium text-sm">4 Broadleaf Close, Dibden Purlieu, Southampton SO45 4AY</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="reveal-right">
        <form class="bg-white/[0.04] backdrop-blur-sm rounded-2xl p-8 border border-white/[0.08] space-y-5">
          <div>
            <label class="block text-xs font-body text-white/50 uppercase tracking-wider mb-2">Your Name</label>
            <input type="text" name="name" required class="contact-input w-full px-4 py-3 rounded-xl font-body text-sm" placeholder="John Smith" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-body text-white/50 uppercase tracking-wider mb-2">Phone</label>
              <input type="tel" name="phone" required class="contact-input w-full px-4 py-3 rounded-xl font-body text-sm" placeholder="07123 456789" />
            </div>
            <div>
              <label class="block text-xs font-body text-white/50 uppercase tracking-wider mb-2">Postcode</label>
              <input type="text" name="postcode" class="contact-input w-full px-4 py-3 rounded-xl font-body text-sm" placeholder="SO14 1AA" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-body text-white/50 uppercase tracking-wider mb-2">How Can We Help?</label>
            <textarea name="message" rows="4" class="contact-input w-full px-4 py-3 rounded-xl font-body text-sm resize-none" placeholder="Describe the job or issue..."></textarea>
          </div>

          <button type="submit" class="copper-cta-form w-full py-3.5 rounded-xl text-white font-medium font-body transition-all duration-300 hover:scale-[1.01] hover:shadow-lg flex items-center justify-center gap-2">
            Send Message
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .contact-input {
    background: rgba(250, 248, 245, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    transition: all 0.3s ease;
  }

  .contact-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .contact-input:focus {
    outline: none;
    border-color: rgba(198, 125, 74, 0.5);
    background: rgba(250, 248, 245, 0.12);
    box-shadow: 0 0 0 3px rgba(198, 125, 74, 0.1);
  }

  .copper-cta-form {
    background: linear-gradient(135deg, #C67D4A 0%, #D4945F 50%, #B8693A 100%);
    box-shadow: 0 4px 16px rgba(198, 125, 74, 0.3);
  }

  .copper-cta-form:hover {
    box-shadow: 0 6px 24px rgba(198, 125, 74, 0.45);
  }
</style>
